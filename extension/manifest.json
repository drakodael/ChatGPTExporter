{
  "manifest_version": 3,
  "name": "ChatGPT Local Exporter",
  "version": "1.2-private",
  "description": "Export the currently open ChatGPT conversation to a local Markdown file. No analytics, attachments, raw JSON, clipboard access, background worker, native messaging, or persistent site access.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export this chat locally",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "permissions": [
    "scripting",
    "activeTab"
  ]
}
